# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Монеты для /top и рассылки (id из CoinGecko через запятую)
WATCHLIST=bitcoin,ethereum,solana,binancecoin,ripple,cardano,dogecoin,avalanche-2,chainlink,toncoin
# Час ежедневной рассылки по UTC
DIGEST_HOUR_UTC=8
# Необязательно: демо-ключ CoinGecko для повышенных лимитов
COINGECKO_API_KEY=
# Необязательно: ключ Anthropic для ИИ-анализа новостей (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Фильтр рынка: не покупать, пока BTC ниже своей N-дневной средней (0 — выключить)
BTC_FILTER_DAYS=200
